+  "glossary": {
+    "ACC": "Adaptive Cruise Control - Maintains set speed and follows traffic",
+    "ALC": "Automatic Lane Centering / Automatic Lane Change - Keeps car centered or changes lanes automatically",
+    "BSM": "Blind Spot Monitoring - Vehicle sensors detecting cars in adjacent lanes",
+    "DEC": "Dynamic Experimental Control - Contextual switching between Chill and Experimental mode",
+    "E2E": "End-to-End - AI neural network that directly predicts vehicle driving path",
+    "ESCC": "Enhanced Smart Cruise Control - Hyundai/Kia cruise management and button integration",
+    "Firehose": "Large-scale automated driving telemetry upload system contributing to driving model training",
+    "HDA": "Highway Driving Assist - Hyundai/Kia native factory highway system",
+    "HKG": "Hyundai/Kia/Genesis - South Korean automotive platform family",
+    "ICBM": "Intelligent Cruise Button Management - Electronically manages steering wheel cruise buttons",
+    "LDW": "Lane Departure Warning - Visual/haptic warnings when drifting out of lane",
+    "MADS": "Modular Assistive Driving System - sunnypilot exclusive decoupled steering and cruise architecture",
+    "MICI": "comma four hardware platform code designation",
+    "NNLC": "Neural Network Lateral Control - Deep learning model predicting steering trajectories",
+    "OSM": "OpenStreetMap - Open-source global map database used for offline curvature and speed limits",
+    "PID": "Proportional-Integral-Derivative - Classic mathematical feedback controller for steering",
+    "SDSU": "Smart DSU - Aftermarket hardware interceptor for older Toyota radar cruise support",
+    "SLA": "Speed Limit Assist - Automatic cruise set-speed adjustment based on legal road limits",
+    "SCC-M": "Smart Cruise Control Map - Curve speed reduction based on OSM map geometry",
+    "SCC-V": "Smart Cruise Control Vision - Curve speed reduction based on front camera perception",
+    "TICI": "comma 3 hardware platform code designation",
+    "TIZI": "comma 3X hardware platform code designation",
+    "TSR": "Traffic Sign Recognition - Camera-based detection of road speed limit signs",
+    "UEM": "Unified Engagement Mode - Single button engagement option for MADS",
+    "WMI": "World Model Iteration - Advanced E2E model architecture",
+    "ZSS": "Zorro Steering Sensor - High-resolution optical steering angle sensor for older Toyotas"
+  }
+}
