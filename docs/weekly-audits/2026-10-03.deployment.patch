+    "LDW": "Lane Departure Warning - Visual/haptic warnings when drifting out of lane",
+    "MADS": "Modular Assistive Driving System - sunnypilot exclusive decoupled steering and cruise architecture",
+    "MICI": "comma four hardware platform code designation",
+    "NNLC": "Neural Network Lateral Control - Deep learning model predicting steering trajectories",
+    "OSM": "OpenStreetMap - Open-source global map database used for offline curvature and speed limits",
+    "PID": "Proportional-Integral-Derivative - Classic mathematical feedback controller for steering",
